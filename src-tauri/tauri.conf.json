{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devku",
  "version": "0.1.0",
  "identifier": "com.devku.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1441",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "devku",
        "width": 960,
        "height": 660,
        "minWidth": 780,
        "minHeight": 520,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright (c) 2026 sap471",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "windows/installer.nsi"
      }
    }
  }
}
